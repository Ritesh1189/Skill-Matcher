# ==========================================
# Skill Match Job Portal - Environment Configuration
# ==========================================

# 1. Spring Boot Backend Configuration
SERVER_PORT=8080

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster credentials:
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/skillmatch_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillmatch_db?retryWrites=true&w=majority

# 2. Frontend Configuration
VITE_API_URL=http://localhost:8080/api

# 3. Swagger UI Paths
SWAGGER_UI_PATH=/swagger-ui.html
API_DOCS_PATH=/v3/api-docs
